  "poems": [
    {
      "id": "0101",
      "ja": {
        "title": "図書館",
        "stanzas": [
          [
            "あなたが借りた本を",
            "あとから私も借りた"
          ],
          [
            "貸出カードの",
            "私の名前は",
            "ちょうどあなたのすぐ下"
          ],
          [
            "まるで",
            "ふたり並んで",
            "座っているみたい"
          ]
        ],
        "lead": "誰にも言えない、小さなしあわせ。"
      },
      "zh": {
        "title": "圖書館",
        "stanzas": [
          [
            "你借過的書",
            "我後來也借了"
          ],
          [
            "借書卡上",
            "我的名字",
            "剛好寫在你下面"
          ],
          [
            "像是",
            "我們並肩坐著"
          ]
        ],
        "lead": "不能告訴任何人的，小小的幸福。"
      },
      "en": {
        "title": "The Library",
        "stanzas": [
          [
            "The book you borrowed",
            "I borrowed it after you"
          ],
          [
            "On the library card",
            "my name",
            "sits right below yours"
          ],
          [
            "as if",
            "we were sitting",
            "side by side"
          ]
        ],
        "lead": "A tiny happiness I can't tell anyone."
      },
      "youtube": "https://youtu.be/FBZxaKIygtw"
    },
    {
      "id": "0102",
      "ja": {
        "title": "反射",
        "stanzas": [
          [
            "君を見ない",
            "窓を見る",
            "窓には君がいて",
            "君を見ている",
            "わたしもいる"
          ],
          [
            "窓の中の君が",
            "窓の外を見た",
            "光と影のあいだでだけ",
            "わたしたちは目が合った"
          ]
        ],
        "lead": "君を見られなくて、窓を見ていた。"
      },
      "zh": {
        "title": "反光",
        "stanzas": [
          [
            "我不看你",
            "我看窗",
            "窗裡有你",
            "也有",
            "正在看你的我"
          ],
          [
            "直到窗裡的你",
            "望向窗外",
            "只有在光影間，",
            "我們對上了眼。"
          ]
        ],
        "lead": "不敢直視你，只好看著窗。"
      },
      "en": {
        "title": "Reflection",
        "stanzas": [
          [
            "I don't look at you",
            "I look at the window",
            "where you are",
            "and so am I,",
            "looking at you"
          ],
          [
            "until the you in the window",
            "looks out of the window,",
            "only between light and shadow",
            "did our eyes meet"
          ]
        ],
        "lead": "I couldn't look at you, so I looked at the window."
      },
      "youtube": "https://youtu.be/r9NtxjCgfpg"
    },
    {
      "id": "0103",
      "ja": {
        "title": "卒業アルバム",
        "stanzas": [
          [
            "ほんとうは",
            "わたしのいいところを覚えていて",
            "と書きたかった"
          ],
          [
            "でも　わたしのいいところは",
            "君に見つけてもらうのを",
            "待っている"
          ],
          [
            "だから",
            "少しだけ消して",
            "わたしを覚えていて",
            "それだけでいい"
          ]
        ],
        "lead": "寄せ書きに残したのは、短い一行だけ。"
      },
      "zh": {
        "title": "畢業紀念冊",
        "stanzas": [
          [
            "本來想寫下",
            "記住我的好"
          ],
          [
            "可是我的好",
            "都等你發掘"
          ],
          [
            "所以",
            "刪掉一個字",
            "記住我",
            "就好"
          ]
        ],
        "lead": "寫在紀念冊上的，只剩一句。"
      },
      "en": {
        "title": "Yearbook",
        "stanzas": [
          [
            "I meant to write",
            "remember the good in me"
          ],
          [
            "but the good in me",
            "is still waiting",
            "for you to find"
          ],
          [
            "so I cross out a few words:",
            "remember me,",
            "that's all"
          ]
        ],
        "lead": "In your yearbook, I left just one short line."
      },
      "youtube": "https://youtu.be/oJ-fzCuXgVI"
    },
    {
      "id": "0104",
      "ja": {
        "title": "ドン",
        "stanzas": [
          [
            "花火が上がったとき",
            "一緒に見上げたその瞬間",
            "小さな声で言った",
            "好きだよ"
          ],
          [
            "ドン"
          ],
          [
            "君が振り向いて",
            "いま何て言ったの、と聞いた"
          ],
          [
            "光が先に届いて",
            "音があとから来るように",
            "口にした好きは",
            "まだ途中にいる"
          ]
        ],
        "lead": "言ったよ。まだ君に届いていないだけ。"
      },
      "zh": {
        "title": "砰",
        "stanzas": [
          [
            "煙火升起的時候",
            "一起仰頭的瞬間",
            "我小聲說了",
            "喜歡你"
          ],
          [
            "砰"
          ],
          [
            "你轉過頭",
            "問我剛剛說什麼"
          ],
          [
            "像光先到",
            "聲音才來",
            "說出口的喜歡你",
            "還在半路上"
          ]
        ],
        "lead": "我說了喔，只是還沒傳到你那裡。"
      },
      "en": {
        "title": "Boom",
        "stanzas": [
          [
            "When the fireworks rose,",
            "the moment we looked up together,",
            "I said, softly,",
            "I like you"
          ],
          [
            "Boom"
          ],
          [
            "You turned to me",
            "and asked what I'd just said"
          ],
          [
            "Like light arriving first",
            "and sound coming after,",
            "the “I like you” I said out loud",
            "is still on its way"
          ]
        ],
        "lead": "I did say it. It just hasn't reached you yet."
      },
      "youtube": "https://youtu.be/yYyNpCGT3VI"
    },
    {
      "id": "0105",
      "ja": {
        "title": "いい夢",
        "stanzas": [
          [
            "みんなが言う",
            "暮らしには詩がいる",
            "詩を読まないと",
            "夢は見られないって"
          ],
          [
            "詩は　いつまでも覚えられない",
            "でも　君が言ったことは",
            "ひとつ残らず覚えている"
          ],
          [
            "言葉の間(ま)まで",
            "夜には",
            "夢の中で",
            "もう一度おさらいする"
          ],
          [
            "どの一行も",
            "読み終えるのが惜しくて",
            "目を覚ますのが惜しい"
          ]
        ],
        "lead": "君のいる場所は、どこも覚めたくない夢。"
      },
      "zh": {
        "title": "美夢",
        "stanzas": [
          [
            "他們說",
            "生活要讀詩",
            "才可以做夢"
          ],
          [
            "詩，我總是背不起來",
            "可是妳說過的每一句話",
            "我都記得"
          ],
          [
            "連停頓的地方",
            "晚上",
            "還會在夢裡",
            "複習一遍"
          ],
          [
            "每一行",
            "我都捨不得讀完",
            "捨不得醒"
          ]
        ],
        "lead": "有妳在的地方，都是我捨不得醒的夢。"
      },
      "en": {
        "title": "Sweet Dream",
        "stanzas": [
          [
            "They say",
            "you need poems in your life",
            "to be able to dream"
          ],
          [
            "Poems, I can never memorize",
            "but every word you've ever said",
            "I remember"
          ],
          [
            "even the pauses.",
            "At night",
            "I go over them again",
            "in my dreams"
          ],
          [
            "every line",
            "I can't bear to finish,",
            "can't bear to wake"
          ]
        ],
        "lead": "Anywhere you are is a dream I don't want to wake from."
      },
      "youtube": "https://youtu.be/2py7_iePaBU"
    },
    {
      "id": "0106",
      "ja": {
        "title": "百番目の好き",
        "stanzas": [
          [
            "真剣な君",
            "ぼんやりしている君",
            "目を細めて笑う君"
          ],
          [
            "君に百通りの顔があるなら",
            "わたしには百通りの好きがある"
          ],
          [
            "百番目は",
            "わたしの気持ちを",
            "知らない君"
          ]
        ],
        "lead": "君のどんな顔も、好き。"
      },
      "zh": {
        "title": "第一百種喜歡",
        "stanzas": [
          [
            "你認真的樣子",
            "你發呆的樣子",
            "你笑到瞇起眼睛的樣子"
          ],
          [
            "若你有一百種樣子",
            "我就有一百種喜歡"
          ],
          [
            "第一百種",
            "是你不知道",
            "我喜歡你的樣子"
          ]
        ],
        "lead": "你的每一種樣子，我都喜歡。"
      },
      "en": {
        "title": "The Hundredth Way",
        "stanzas": [
          [
            "The way you look when you focus",
            "the way you look when you drift off",
            "the way your eyes crinkle when you laugh"
          ],
          [
            "If you have a hundred ways of being",
            "I have a hundred ways of liking you"
          ],
          [
            "The hundredth",
            "is you, not knowing",
            "that I like you"
          ]
        ],
        "lead": "I like every version of you."
      },
      "youtube": "https://youtu.be/d6acr2yoRFQ"
    },
    {
      "id": "0107",
      "ja": {
        "title": "ミュート",
        "stanzas": [
          [
            "片想いは"
          ],
          [
            "君の前で",
            "好きだよ、のひとことを",
            "ミュートにすること"
          ],
          [
            "でも　胸の中の好きは",
            "耳をつんざくほど鳴り響いて",
            "止められない"
          ]
        ],
        "lead": "声にしない好きほど、うるさい。"
      },
      "zh": {
        "title": "靜音",
        "stanzas": [
          [
            "暗戀"
          ],
          [
            "是在你面前",
            "把喜歡你這句話",
            "調成靜音"
          ],
          [
            "但心裡的喜歡",
            "卻震耳欲聾",
            "無法控制"
          ]
        ],
        "lead": "說不出口的喜歡，最吵。"
      },
      "en": {
        "title": "Mute",
        "stanzas": [
          [
            "A crush"
          ],
          [
            "is muting",
            "the words “I like you”",
            "when I’m in front of you"
          ],
          [
            "but the liking inside me",
            "is deafening,",
            "and I can’t turn it down"
          ]
        ],
        "lead": "The quieter I keep it, the louder it gets."
      },
      "youtube": "https://youtu.be/9-dsOMcT1WA"
    },
    {
      "id": "0108",
      "ja": {
        "title": "迷子",
        "stanzas": [
          [
            "道を覚えるのが苦手で",
            "よく迷子になる"
          ],
          [
            "そのおかげで",
            "本当なら",
            "見られなかった景色を",
            "たくさん見た"
          ],
          [
            "あとになって気づいた",
            "迷っていたんじゃない",
            "この足で確かめてきた世界で",
            "ずっと",
            "君を探していただけ"
          ],
          [
            "たどり着く先が君なら",
            "少しくらい遠回りしても",
            "かまわない"
          ]
        ],
        "lead": "迷っていたんじゃない。君を探していただけ。"
      },
      "zh": {
        "title": "迷路",
        "stanzas": [
          [
            "我不太會認路",
            "常常迷路"
          ],
          [
            "因此看見了",
            "很多本來",
            "不會看見的風景"
          ],
          [
            "後來才知道",
            "我不是迷路",
            "只是一直在",
            "親自丈量過的世界裡",
            "找你"
          ],
          [
            "如果終點是你",
            "繞遠一點",
            "也沒關係"
          ]
        ],
        "lead": "我不是迷路，只是一直在找你。"
      },
      "en": {
        "title": "Lost",
        "stanzas": [
          [
            "I’m bad with directions",
            "I get lost a lot"
          ],
          [
            "so I’ve seen",
            "so many views",
            "I never would have seen"
          ],
          [
            "Later I realized",
            "I wasn’t lost",
            "I was looking for you",
            "all over the world",
            "I’ve walked with my own two feet"
          ],
          [
            "If the end of the road is you",
            "a few extra turns",
            "don’t matter"
          ]
        ],
        "lead": "I wasn’t lost. I was looking for you."
      },
      "youtube": "https://youtu.be/jC653mdz8V0"
    },
    {
      "id": "0109",
      "ja": {
        "title": "それから",
        "stanzas": [
          [
            "むかしは",
            "君にもう少し見てほしくて",
            "がむしゃらにがんばっていた"
          ],
          [
            "それから",
            "がんばること自体と",
            "早起きの朝の風を",
            "好きになった"
          ],
          [
            "いつか君がわたしを見るなら",
            "見てほしいのは",
            "好きなことに夢中になって",
            "少しよくなったわたし"
          ]
        ],
        "lead": "いまは、好きだからがんばっている。"
      },
      "zh": {
        "title": "後來",
        "stanzas": [
          [
            "我曾經",
            "為了讓你多看我一眼",
            "拚命努力"
          ],
          [
            "後來",
            "我愛上了努力本身",
            "與早起時的風"
          ],
          [
            "如果有一天你看見我",
            "希望你看見的",
            "是因熱愛",
            "而變得更好的我"
          ]
        ],
        "lead": "後來我努力，是因為熱愛。"
      },
      "en": {
        "title": "Since Then",
        "stanzas": [
          [
            "I used to",
            "work so hard",
            "just so you’d look at me a little longer"
          ],
          [
            "Since then",
            "I’ve fallen for the work itself",
            "and the wind on early mornings"
          ],
          [
            "If you ever do see me",
            "I hope what you see",
            "is the me who grew",
            "by loving what I do"
          ]
        ],
        "lead": "Now I try hard because I love it."
      }
    },
